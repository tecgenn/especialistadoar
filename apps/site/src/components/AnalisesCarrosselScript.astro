---
/**
 * O comportamento do carrossel de Análises (ticket 97). Fica num componente
 * separado de propósito: com uma única Análise — ou nenhuma — a home não baixa
 * código de rotação, e o `<script>` só entra no bundle quando o componente é
 * renderizado.
 */
---

<script>
  import {
    deveAvancarAutomaticamente,
    indiceAnterior,
    INTERVALO_CARROSSEL_MS,
    normalizarIndice,
    proximoIndice,
  } from "../lib/carrossel.ts";

  for (const raiz of document.querySelectorAll<HTMLElement>(
    "[data-carrossel]",
  )) {
    const slides = Array.from(
      raiz.querySelectorAll<HTMLElement>("[data-carrossel-slide]"),
    );
    if (slides.length < 2) {
      continue;
    }

    const botaoAnterior = raiz.querySelector<HTMLButtonElement>(
      "[data-carrossel-anterior]",
    );
    const botaoProximo = raiz.querySelector<HTMLButtonElement>(
      "[data-carrossel-proximo]",
    );
    const botaoPausa = raiz.querySelector<HTMLButtonElement>(
      "[data-carrossel-pausa]",
    );
    const indicador = raiz.querySelector<HTMLElement>(
      "[data-carrossel-indicador]",
    );
    const anuncio = raiz.querySelector<HTMLElement>(
      "[data-carrossel-anuncio]",
    );
    const intervalo = Number(raiz.dataset.intervalo) || INTERVALO_CARROSSEL_MS;
    const menosMovimento = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let atual = 0;
    let pausado = false;
    let sobInteracao = false;
    let naTela = true;
    let timer: number | undefined;

    raiz.setAttribute("data-carrossel-ativo", "");

    const parar = (): void => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const podeGirar = (): boolean =>
      deveAvancarAutomaticamente({
        total: slides.length,
        reduzido: menosMovimento.matches,
        pausado: pausado || sobInteracao,
        visivel: naTela && !document.hidden,
      });

    const mostrar = (indice: number, anunciar: boolean): void => {
      atual = normalizarIndice(indice, slides.length);
      slides.forEach((slide, posicao) => {
        const ativo = posicao === atual;
        slide.toggleAttribute("data-ativo", ativo);
        slide.hidden = !ativo;
      });
      if (indicador !== null) {
        indicador.textContent = `${atual + 1} / ${slides.length}`;
      }
      if (anunciar && anuncio !== null) {
        const titulo = slides[atual]?.dataset.titulo ?? "";
        anuncio.textContent = `Análise ${atual + 1} de ${slides.length}: ${titulo}`;
      }
    };

    const girar = (): void => {
      parar();
      if (!podeGirar()) {
        return;
      }
      timer = window.setInterval(() => {
        mostrar(proximoIndice(atual, slides.length), false);
      }, intervalo);
    };

    const sincronizarPausa = (): void => {
      if (botaoPausa !== null) {
        botaoPausa.hidden = menosMovimento.matches;
        // O rótulo diz a ação disponível; não há `aria-pressed` porque o nome
        // acessível muda junto com o estado.
        botaoPausa.textContent = pausado ? "Retomar" : "Pausar";
      }
    };

    botaoAnterior?.addEventListener("click", () => {
      mostrar(indiceAnterior(atual, slides.length), true);
      girar();
    });

    botaoProximo?.addEventListener("click", () => {
      mostrar(proximoIndice(atual, slides.length), true);
      girar();
    });

    botaoPausa?.addEventListener("click", () => {
      pausado = !pausado;
      sincronizarPausa();
      girar();
    });

    // O ponteiro e o foco pausam enquanto estão sobre o bloco: quem lê ou
    // navega pelos controles não é interrompido por uma troca de quadro.
    raiz.addEventListener("pointerenter", () => {
      sobInteracao = true;
      girar();
    });
    raiz.addEventListener("pointerleave", () => {
      sobInteracao = false;
      girar();
    });
    raiz.addEventListener("focusin", () => {
      sobInteracao = true;
      girar();
    });
    raiz.addEventListener("focusout", (evento) => {
      const destino = evento.relatedTarget;
      if (!(destino instanceof Node) || !raiz.contains(destino)) {
        sobInteracao = false;
        girar();
      }
    });

    document.addEventListener("visibilitychange", girar);
    menosMovimento.addEventListener("change", () => {
      sincronizarPausa();
      girar();
    });

    if ("IntersectionObserver" in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          naTela = entradas[0]?.isIntersecting ?? true;
          girar();
        },
        { threshold: 0.1 },
      );
      observador.observe(raiz);
    }

    mostrar(0, false);
    sincronizarPausa();
    girar();
  }
</script>
