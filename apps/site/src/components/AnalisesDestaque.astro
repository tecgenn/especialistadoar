---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { DestaqueAnalise } from "../lib/analises.ts";
import {
  INTERVALO_CARROSSEL_MS,
  modoDaSecaoDeAnalises,
} from "../lib/carrossel.ts";
import AnalisesCarrosselScript from "./AnalisesCarrosselScript.astro";
import OfertaFaixa from "./OfertaFaixa.astro";
import CabecalhoDeSecao from "./primitivos/CabecalhoDeSecao.astro";
import Icone from "./primitivos/Icone.astro";

/**
 * "Análises em destaque" da home (tickets 71 e 97). As Análises e as Ofertas de
 * cada uma chegam já resolvidas do build — o cliente não baixa `analises.json`
 * nem `ofertas.json` para renderizá-lo.
 *
 * Com uma Análise, o bloco é um destaque estático. Com duas ou mais, vira um
 * carrossel: um quadro por vez, controles de anterior/próxima, pausa explícita
 * e rotação automática que para no ponteiro, no foco, fora da tela, com a aba
 * escondida e em `prefers-reduced-motion`. O HTML traz todos os quadros e os
 * controles já estão no markup; sem JavaScript a lista aparece inteira, como
 * uma pilha de destaques, e nada fica escondido. Sem Análise, nada renderiza.
 *
 * A Análise pode comparar dois Aparelhos: o quadro mostra as Ofertas de todos
 * eles (o `ofertas` já vem somado do build), com o link de afiliado de cada um.
 */
interface Props {
  destaques: DestaqueAnalise[];
}

const { destaques } = Astro.props;
const modo = modoDaSecaoDeAnalises(destaques.length);
const emCarrossel = modo === "carrossel";

// As imagens de abertura vivem em `src/assets`; o frontmatter aponta o caminho
// relativo a essa pasta e o glob resolve o arquivo (e as larguras) no build.
const imagens = import.meta.glob<ImageMetadata>(
  "../assets/**/*.{avif,jpeg,jpg,png,webp}",
  { eager: true, import: "default" },
);

function imagemDe(caminho: string | undefined): ImageMetadata | undefined {
  if (caminho === undefined) {
    return undefined;
  }
  return imagens[`../assets/${caminho}`];
}
---

{
  modo !== "oculta" ? (
    <section
      class="analises-destaque"
      data-carrossel={emCarrossel ? true : undefined}
      data-intervalo={emCarrossel ? INTERVALO_CARROSSEL_MS : undefined}
      aria-labelledby="analises-destaque-titulo"
      aria-roledescription={emCarrossel ? "carrossel" : undefined}
    >
      <CabecalhoDeSecao
        icone="analise"
        id="analises-destaque-titulo"
        titulo="Análises em destaque"
        lead="Leituras editoriais sobre aparelhos de ar-condicionado, com link para os dados oficiais do INMETRO na ficha de cada Aparelho."
        class="analises-destaque-cabecalho"
      >
        {emCarrossel ? (
          <div class="analises-carrossel-controles" data-carrossel-controles slot="acoes">
            <button
              type="button"
              class="analises-carrossel-controle"
              data-carrossel-anterior
              aria-label="Análise anterior"
            >
              <Icone nome="seta-esquerda" tamanho={16} />
              <span>Anterior</span>
            </button>
            <p
              class="analises-carrossel-indicador"
              data-carrossel-indicador
              aria-hidden="true"
            >
              1 / {destaques.length}
            </p>
            <button
              type="button"
              class="analises-carrossel-controle"
              data-carrossel-proximo
              aria-label="Próxima análise"
            >
              <span>Próxima</span>
              <Icone nome="seta-direita" tamanho={16} />
            </button>
            <button
              type="button"
              class="analises-carrossel-controle analises-carrossel-pausa"
              data-carrossel-pausa
            >
              Pausar
            </button>
          </div>
        ) : null}
      </CabecalhoDeSecao>
      <div class="analises-carrossel-palco">
        <ul class="analises-destaque-lista">
          {destaques.map(({ analise, ofertas }, indice) => {
            const imagem = imagemDe(analise.imagem);
            return (
              <li
                class="analises-slide"
                data-carrossel-slide={emCarrossel ? true : undefined}
                data-titulo={analise.titulo}
              >
                <article
                  class="analises-slide-conteudo"
                  role={emCarrossel ? "group" : undefined}
                  aria-roledescription={emCarrossel ? "slide" : undefined}
                  aria-label={
                    emCarrossel
                      ? `${indice + 1} de ${destaques.length}`
                      : undefined
                  }
                >
                  {imagem ? (
                    <div class="analises-destaque-imagem">
                      <Image
                        src={imagem}
                        alt={analise.imagemAlt ?? ""}
                        widths={[480, 720, 1080]}
                        sizes="(min-width: 64rem) 30rem, 100vw"
                        loading={indice === 0 ? "eager" : "lazy"}
                      />
                    </div>
                  ) : null}
                  <div class="analises-destaque-texto">
                    <p class="analises-destaque-data">
                      <time datetime={analise.data}>{analise.data}</time>
                    </p>
                    <h3>
                      <a href={analise.url}>{analise.titulo}</a>
                    </h3>
                    <p class="intro">{analise.descricao}</p>
                    <OfertaFaixa
                      ofertas={ofertas}
                      titulo="Onde comprar"
                      nivelTitulo={4}
                    />
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
      {emCarrossel ? (
        <p class="apenas-leitor" data-carrossel-anuncio aria-live="polite"></p>
      ) : null}
      <p class="analises-destaque-todas">
        <a href="/analises/">Todas as análises</a>
      </p>
    </section>
  ) : null
}

{emCarrossel ? <AnalisesCarrosselScript /> : null}
