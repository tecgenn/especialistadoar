---
/**
 * Um CTA em cartão da Análise (ticket 47). O cartão é o bloco visual do CTA; as
 * ações dentro dele são botões — nunca links soltos no meio do texto. A
 * divulgação de afiliado vive no próprio link de Oferta (ticket 106), não aqui.
 */
interface Props {
  titulo: string;
  descricao?: string;
}

const { titulo, descricao } = Astro.props;
---

<section class="cta-cartao">
  <h2 class="cta-cartao-titulo">{titulo}</h2>
  {descricao ? <p class="cta-cartao-descricao">{descricao}</p> : null}
  <div class="cta-cartao-acoes"><slot /></div>
</section>
