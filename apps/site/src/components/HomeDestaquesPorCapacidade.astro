---
import { formatarFaixa } from "../lib/ficha.ts";
import {
  type CartaoDestaquePorCapacidade,
  formatarCapacidade,
  formatarNumero,
  linkDaTabela,
} from "../lib/home.ts";
import { ATRIBUTOS_OFERTA, MARCADOR_OFERTA } from "../lib/ofertas.ts";

/**
 * Entrada editorial por capacidade exata da home (ticket 96): até três cartões
 * de ficha técnica de Aparelhos com Análise publicada e/ou Oferta naquela
 * capacidade. Não é régua, nem ranking, nem carrossel: é uma lista de modelos,
 * com os Valores oficiais do INMETRO e os links contextuais de cada Aparelho.
 */
interface Props {
  capacidadeBtu: number;
  cartoes: CartaoDestaquePorCapacidade[];
  /** Aparelhos da base na capacidade, para o link para a tela completa. */
  totalNaCapacidade: number;
}

const { capacidadeBtu, cartoes, totalNaCapacidade } = Astro.props;
const id = `capacidade-${capacidadeBtu}`;
---

<section class="home-destaques-capacidade" id={id} aria-labelledby={`${id}-titulo`}>
  <header class="home-destaques-cabecalho">
    <div>
      <h2 id={`${id}-titulo`}>
        Aparelhos de {formatarNumero(capacidadeBtu)} BTUs em destaque
      </h2>
      <p class="intro">
        Modelos com análise publicada ou link de afiliado nesta capacidade.
      </p>
    </div>
    <p class="home-destaques-total">
      <span class="home-destaques-contagem">
        {formatarNumero(totalNaCapacidade)} aparelhos nesta capacidade
      </span>
      <a href={linkDaTabela({ btu: capacidadeBtu })}>
        Ver os de {formatarCapacidade(capacidadeBtu)}
      </a>
    </p>
  </header>
  <ul class="home-destaques-cartoes">
    {
      cartoes.map((cartao) => (
        <li class="home-destaque-cartao">
          <article>
            <p class="home-destaque-identidade">
              <span class="home-destaque-marca">{cartao.marca}</span>
              <strong class="home-destaque-modelo">
                <a href={`/aparelhos/${cartao.aparelhoId}/`}>{cartao.modelo}</a>
              </strong>
            </p>
            <p class="home-destaque-atributos">
              <span>{formatarCapacidade(cartao.capacidadeBtu)}</span>
              <span>{cartao.tipo ?? "Tipo não informado"}</span>
            </p>
            <dl class="home-destaque-leituras">
              <div>
                <dt>IDRS</dt>
                <dd>{formatarFaixa(cartao.idrs)}</dd>
              </div>
              <div>
                <dt>Consumo anual</dt>
                <dd>{formatarFaixa(cartao.consumoAnualKwh, " kWh/ano")}</dd>
              </div>
            </dl>
            <p class="home-destaque-acoes">
              {cartao.analise && <a href={cartao.analise.url}>Ler análise</a>}
              {cartao.oferta && (
                <a class="home-destaque-oferta" href={cartao.oferta.url} {...ATRIBUTOS_OFERTA}>
                  <span>
                    {cartao.oferta.rotulo} — {cartao.oferta.loja}
                  </span>{" "}
                  <span class="home-destaque-marcador">{MARCADOR_OFERTA}</span>
                </a>
              )}
            </p>
          </article>
        </li>
      ))
    }
  </ul>
</section>
