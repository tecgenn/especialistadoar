---
/**
 * Lista de links populares da home (ticket 71): rótulo em grotesca, contagem
 * em mono à direita e hairline por linha. Não é chip nem cartão — é uma lista
 * de caminhos com hierarquia tipográfica. A variante (`classe`) muda só a
 * densidade de colunas: capacidades em duas, marcas em três.
 */
interface Props {
  titulo: string;
  intro: string;
  itens: Array<{ href: string; texto: string; contagem: string }>;
  class?: string;
}

const { titulo, intro, itens, class: classe } = Astro.props;
---

<section class:list={["home-populares", classe]}>
  <h2>{titulo}</h2>
  <p class="home-populares-intro intro">{intro}</p>
  <ul class="home-populares-lista">
    {
      itens.map(({ href, texto, contagem }) => (
        <li>
          <a href={href}>
            <span class="home-populares-texto">{texto}</span>
            <span class="home-populares-contagem">{contagem}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
