---
import { type Oferta, ofertaExibida } from "../lib/ofertas.ts";
import OfertaCartao from "./primitivos/OfertaCartao.astro";

/**
 * Um único CTA de Oferta. Puro e reutilizável: recebe a `Oferta` e não sabe de
 * onde ela veio. Resolve o rótulo na camada pura e delega a marcação ao cartão
 * compartilhado com a home e com a ilha da Comparação (ticket 106).
 */
interface Props {
  oferta: Oferta;
}

const { oferta } = Astro.props;
---

<OfertaCartao oferta={ofertaExibida(oferta)} />
