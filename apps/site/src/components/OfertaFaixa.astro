---
import { ofertasDoAparelho } from "../conteudo/ofertas.ts";
import type { Oferta } from "../lib/ofertas.ts";
import OfertaCartao from "./OfertaCartao.astro";

/**
 * A faixa/banner de Ofertas de **um** Aparelho. Recebe a lista já resolvida ou
 * um `aparelhoId` (nesse caso busca e valida as Ofertas no build) — é o mesmo
 * componente na ficha do Aparelho, na Análise e no MDX de uma Análise.
 *
 * Sem Oferta, não renderiza nada: nunca há CTA vazio. O aviso de link comercial
 * acompanha os cartões, separando-os dos dados técnicos (ADR-0010).
 */
interface Props {
  ofertas?: Oferta[];
  aparelhoId?: string;
  /** Título da seção; a ficha usa "Ofertas", a Análise usa um CTA. */
  titulo?: string;
  /** Nível do título, para respeitar a hierarquia da página que recebe a faixa. */
  nivelTitulo?: 2 | 3 | 4;
}

const { aparelhoId, titulo = "Ofertas", nivelTitulo = 2 } = Astro.props;
const ofertas =
  Astro.props.ofertas ??
  (aparelhoId === undefined ? [] : ofertasDoAparelho(aparelhoId));
const Titulo = `h${nivelTitulo}`;
---

{
  ofertas.length > 0 ? (
    <section class="ofertas">
      <Titulo>{titulo}</Titulo>
      <p class="intro">
        Links comerciais (de afiliado), exibidos apenas aqui no site. Não fazem
        parte dos dados técnicos do INMETRO e não alteram as informações acima.
      </p>
      <ul>
        {ofertas.map((oferta) => (
          <li>
            <OfertaCartao oferta={oferta} />
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
