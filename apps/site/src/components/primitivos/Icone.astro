---
import { caminhosDoIcone, type NomeDeIcone } from "../../lib/icones.ts";

/**
 * Um ícone de linha, inline e decorativo (ticket 68). Traço de 1,5 px,
 * `currentColor`, 24 × 24 de grade e `aria-hidden`: quem carrega significado é o
 * texto ao lado. Não há pacote de ícones nem requisição externa.
 */
interface Props {
  nome: NomeDeIcone;
  /** 12 (separador), 16 (dentro de campo/botão), 20 (padrão) ou 24. */
  tamanho?: 12 | 16 | 20 | 24;
  class?: string;
}

const { nome, tamanho = 20, class: classe } = Astro.props;
const caminhos = caminhosDoIcone(nome);
---

<svg
  class:list={["icone", classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {caminhos.map((caminho) => <path d={caminho} />)}
</svg>
