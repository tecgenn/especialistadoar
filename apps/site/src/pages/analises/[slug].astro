---
import { render } from "astro:content";
import aparelhosJson from "@dados/aparelhos.json";
import consultaJson from "@dados/consulta.json";
import manifestJson from "@dados/manifest.json";
import type {
  Aparelho,
  ItemConsulta,
  Manifest,
} from "@especialista-do-ar/pipeline";
import { versaoAtualDo } from "@especialista-do-ar/pipeline";
import CtaCartao from "../../components/CtaCartao.astro";
import OfertaCartao from "../../components/OfertaCartao.astro";
import {
  carregarAnalises,
  type EntradaAnalise,
} from "../../conteudo/analises.ts";
import { ofertasDoAparelho } from "../../conteudo/ofertas.ts";
import Base from "../../layouts/Base.astro";
import type { Analise } from "../../lib/analises.ts";
import type { Oferta } from "../../lib/ofertas.ts";

export async function getStaticPaths() {
  const aparelhos = aparelhosJson as Aparelho[];
  const porId = new Map(aparelhos.map((aparelho) => [aparelho.id, aparelho]));
  const capacidadesPorId = new Map(
    (consultaJson as ItemConsulta[]).map((item) => [
      item.id,
      item.capacidadesBtu,
    ]),
  );
  const { analises, entradas } = await carregarAnalises();
  return analises.map((analise) => ({
    params: { slug: analise.slug },
    props: {
      analise,
      entrada: entradas.get(analise.slug),
      aparelho: porId.get(analise.aparelhoId),
      capacidadesBtu: capacidadesPorId.get(analise.aparelhoId) ?? [],
    },
  }));
}

interface Props {
  analise: Analise;
  entrada: EntradaAnalise;
  aparelho: Aparelho | undefined;
  capacidadesBtu: number[];
}

const { analise, entrada, aparelho, capacidadesBtu } = Astro.props;
const { Content } = await render(entrada);
const versao = versaoAtualDo(manifestJson as Manifest);

// Toda Análise publicada no build tem, no mínimo, três CTAs em cartão: o do
// topo, o do meio (Assistente) e o do fim (Oferta quando houver + ficha +
// tabela filtrada). Com Oferta são quatro cartões (topo e fim comerciais).
const ofertas: Oferta[] =
  aparelho === undefined ? [] : ofertasDoAparelho(aparelho.id);
const capacidadeBtu = capacidadesBtu[0];
const numero = new Intl.NumberFormat("pt-BR");
const urlTabela =
  capacidadeBtu === undefined
    ? "/aparelhos/"
    : `/aparelhos/?btu=${capacidadeBtu}`;
const urlFicha =
  aparelho === undefined ? undefined : `/aparelhos/${aparelho.id}/`;

const url = new URL(analise.url, Astro.site).href;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: analise.titulo,
  description: analise.descricao,
  datePublished: analise.data,
  inLanguage: "pt-BR",
  url,
  mainEntityOfPage: url,
  isPartOf: {
    "@type": "WebSite",
    name: "Especialista do Ar",
    url: Astro.site?.href,
  },
  author: {
    "@type": "Organization",
    name: "Especialista do Ar",
    url: Astro.site?.href,
  },
  publisher: {
    "@type": "Organization",
    name: "Especialista do Ar",
    url: Astro.site?.href,
  },
  ...(aparelho === undefined
    ? {}
    : {
        about: {
          "@type": "Product",
          name: `${aparelho.marca} ${aparelho.modelo}`,
          url: new URL(urlFicha ?? "/", Astro.site).href,
        },
      }),
};
---

<Base
  titulo={`${analise.titulo} — Especialista do Ar`}
  descricao={analise.descricao}
  canonical={url}
  jsonLd={jsonLd}
>
  <article class="analise">
    <p><a href="/analises/">← Todas as análises</a></p>
    <h1>{analise.titulo}</h1>
    <p class="intro">
      <time datetime={analise.data}>{analise.data}</time>
    </p>

    <aside
      class="analise-transparencia"
      role="note"
      aria-label="Aviso de transparência"
    >
      <p><strong>Aviso de transparência</strong></p>
      <p>
        Este artigo contém links de afiliados. Podemos receber uma comissão
        pelas compras realizadas através desses links, sem custo adicional para
        você.
      </p>
    </aside>

    {
      // CTA 1 (topo, após o lead): a Oferta quando há; senão a ficha técnica.
      // Um Aparelho Ausente não tem ficha: o cartão leva à tabela.
      aparelho === undefined ? (
        <CtaCartao
          titulo="Ver todos os aparelhos"
          descricao="O modelo desta análise não consta na Versão atual, mas a tabela traz os aparelhos comparáveis."
        >
          <a class="cta-acao" href="/aparelhos/">
            Ver todos os aparelhos
          </a>
        </CtaCartao>
      ) : ofertas.length > 0 ? (
        <CtaCartao
          titulo="Ver oferta"
          descricao="Onde encontrar este modelo — o preço é o do dia."
          comercial
        >
          <ul class="cta-ofertas">
            {ofertas.map((oferta) => (
              <li>
                <OfertaCartao oferta={oferta} />
              </li>
            ))}
          </ul>
        </CtaCartao>
      ) : (
        <CtaCartao
          titulo="Ver ficha técnica"
          descricao="Capacidade, consumo, IDRS, Classe e tensão nos dados oficiais do INMETRO."
        >
          <a class="cta-acao" href={urlFicha}>
            Ver ficha técnica
          </a>
        </CtaCartao>
      )
    }

    <div class="analise-corpo">
      <Content />
    </div>

    {
      // CTA 2 (meio): o Assistente, após o corpo do artigo.
      <CtaCartao
        titulo="Calcular os BTUs do meu ambiente"
        descricao="Responda cinco perguntas e veja a capacidade ideal, com a conta aberta."
      >
        <a class="cta-acao" href="/assistente/">
          Calcular os BTUs do meu ambiente
        </a>
      </CtaCartao>
    }

    {
      aparelho === undefined ? (
        <section class="analise-aviso">
          <h2>Modelo fora da tabela atual</h2>
          <p>
            O aparelho desta análise não consta na Versão atual da tabela do
            INMETRO
            {versao ? ` (${versao.obtidoEm})` : ""}. A análise continua
            publicada, mas não há dados técnicos oficiais para exibir.
          </p>
        </section>
      ) : (
        <section class="analise-ficha">
          <h2>Dados oficiais do INMETRO</h2>
          <p>
            A ficha técnica de {aparelho.marca} {aparelho.modelo} traz os
            Valores oficiais — capacidade, consumo, IDRS e tensão.
          </p>
          <p>
            <a href={urlFicha}>Ver ficha técnica</a>
          </p>
        </section>
      )
    }

    {
      // CTA 3 (fim): a Oferta, quando houver.
      ofertas.length > 0 ? (
        <CtaCartao
          titulo="Onde comprar"
          descricao="O preço é o do dia; confira a tensão e a instalação antes."
          comercial
        >
          <ul class="cta-ofertas">
            {ofertas.map((oferta) => (
              <li>
                <OfertaCartao oferta={oferta} />
              </li>
            ))}
          </ul>
        </CtaCartao>
      ) : null
    }

    {
      // CTA 4 (fim): ficha técnica e tabela filtrada pela capacidade. Sem
      // Oferta, este é o terceiro cartão; sem Aparelho na Versão atual, ele se
      // resolve na tabela.
      aparelho === undefined ? (
        <CtaCartao
          titulo="Continue a pesquisa"
          descricao="Compare outros aparelhos pelos dados oficiais do INMETRO."
        >
          <a class="cta-acao" href="/aparelhos/">
            Ver todos os aparelhos
          </a>
        </CtaCartao>
      ) : (
        <CtaCartao
          titulo="Continue a pesquisa"
          descricao="Confira os números oficiais e compare com aparelhos da mesma capacidade."
        >
          <a class="cta-acao" href={urlFicha}>
            Ver ficha técnica
          </a>
          {capacidadeBtu === undefined ? (
            <a class="cta-acao" href={urlTabela}>
              Ver todos os aparelhos
            </a>
          ) : (
            <a class="cta-acao" href={urlTabela}>
              Ver outros de {numero.format(capacidadeBtu)} BTU/h
            </a>
          )}
        </CtaCartao>
      )
    }
  </article>
</Base>
