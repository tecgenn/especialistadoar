---
import aparelhosJson from "@dados/aparelhos.json";
import manifestJson from "@dados/manifest.json";
import {
  type Aparelho,
  type Manifest,
  versaoAtualDo,
} from "@especialista-do-ar/pipeline";
import CalculadoraCusto from "../../components/CalculadoraCusto.tsx";
import OfertaFaixa from "../../components/OfertaFaixa.astro";
import EtiquetaClasse from "../../components/primitivos/EtiquetaClasse.astro";
import Icone from "../../components/primitivos/Icone.astro";
import Leitura from "../../components/primitivos/Leitura.astro";
import Trilha from "../../components/primitivos/Trilha.astro";
import { carregarAnalises } from "../../conteudo/analises.ts";
import { marcaCatalogoDo } from "../../conteudo/marcas-catalogo.ts";
import { ofertasDoAparelho } from "../../conteudo/ofertas.ts";
import { carregarTarifas } from "../../conteudo/tarifas.ts";
import Base from "../../layouts/Base.astro";
import { type Analise, mapaPorAparelho } from "../../lib/analises.ts";
import { HORAS_ANO } from "../../lib/custo.ts";
import {
  agruparVariantes,
  descreverCapacidade,
  EXPLICADORES_DA_FICHA,
  etiquetasDaFicha,
  formatarCelula,
  formatarFaixa,
  gradeDeCondicoes,
  indiceDaFicha,
  leiturasDaFicha,
  resumoDaFicha,
  titulosDosBlocos,
} from "../../lib/ficha.ts";
import type { Oferta } from "../../lib/ofertas.ts";

export async function getStaticPaths() {
  const aparelhos = aparelhosJson as Aparelho[];
  // O link de volta depende do mapa `aparelhoId → Análise` construído no build.
  const { analises } = await carregarAnalises();
  const analisePorAparelho = mapaPorAparelho(analises);
  return aparelhos.map((aparelho) => ({
    params: { id: aparelho.id },
    props: {
      aparelho,
      // As Ofertas vêm do glue do site, que valida o insumo (inclusive Oferta
      // órfã) no primeiro uso do build — ver `conteudo/ofertas.ts` e ADR-0010.
      ofertas: ofertasDoAparelho(aparelho.id),
      analise: analisePorAparelho.get(aparelho.id),
    },
  }));
}

interface Props {
  aparelho: Aparelho;
  ofertas: Oferta[];
  analise: Analise | undefined;
}

const { aparelho, ofertas, analise } = Astro.props;

// A Marca de catálogo (ADR-0016) é o agrupamento curado usado pelo filtro e pelo
// link "Ver outros aparelhos da marca". A ficha continua exibindo a Marca
// oficial do INMETRO no título, no `<h1>` e na URL.
const marcaCatalogo = marcaCatalogoDo(aparelho);

// Variantes de dados idênticos (127 V e 220 V) viram um bloco só; as vazias
// desaparecem. O resumo é do Aparelho inteiro, com faixa quando as Variantes
// divergem — a ficha continua mostrando cada condição de ensaio logo abaixo.
const blocos = agruparVariantes(aparelho.variantes);
const resumo = resumoDaFicha(blocos);
const titulos = titulosDosBlocos(blocos);

// O topo da ficha (tickets 62 e 75): as etiquetas de identificação e as três
// leituras saem do mesmo resumo que as seções, com faixa quando as Variantes
// divergem. O índice só lista seções que existem nesta página.
const etiquetas = etiquetasDaFicha(resumo, aparelho.registros);
const leituras = leiturasDaFicha(resumo);
const trilha = [
  { rotulo: "Aparelhos", href: "/aparelhos/" },
  {
    rotulo: marcaCatalogo,
    href: `/aparelhos/?marca=${encodeURIComponent(marcaCatalogo)}`,
  },
  { rotulo: aparelho.modelo },
];

// As tarifas de referência são curadoria do site (ADR-0022), validadas no build
// e cacheadas por caminho: a mesma leitura serve as 2.460 fichas.
const tarifas = carregarTarifas();

const identificacao: Array<[string, string | null]> = [
  ["Tipo", aparelho.tipo],
  ["Função", aparelho.funcao],
  ["Unidade interna", aparelho.unidadeInterna],
  ["Unidade externa", aparelho.unidadeExterna],
  ["Fluido refrigerante", aparelho.fluidoRefrigerante],
  ["Fluido especificado", aparelho.fluidoEspecificado],
].filter(([, valor]) => valor !== null && valor !== "");

// O Resumo do datasheet (ticket 76): pares rótulo/valor com hairline, sem
// cartões decorativos. A Classe e a situação continuam vindo do resumo oficial.
const resumoLinhas: Array<[string, string]> = [
  ["Capacidade nominal", descreverCapacidade(resumo)],
  ["IDRS", formatarFaixa(resumo.idrs)],
  ["Classe", resumo.classes.join(", ") || "—"],
  ["Consumo anual", formatarFaixa(resumo.consumosKwh, " kWh/ano")],
  ["Potência em espera", formatarFaixa(resumo.potenciasEsperaW, " W")],
];

const secoesPresentes = new Set([
  "resumo",
  "entenda-os-numeros",
  "consumo-e-custo",
  "condicoes-de-ensaio",
  ...(identificacao.length > 0 ? ["especificacoes"] : []),
  ...(aparelho.registros.length > 0 ? ["registros"] : []),
  "proveniencia",
  ...(ofertas.length > 0 ? ["ofertas"] : []),
]);
const indice = indiceDaFicha(secoesPresentes);

// O cabeçalho de impressão (ticket 78) repete a Versão da tabela do rodapé: a
// folha impressa circula sozinha e precisa da mesma procedência do site.
const versao = versaoAtualDo(manifestJson as Manifest);

const descricao = `${aparelho.marca} ${aparelho.modelo}: capacidade, consumo, IDRS e tensão conforme os Dados declarados do INMETRO.`;
---

<Base titulo={`${aparelho.marca} ${aparelho.modelo} — Especialista do Ar`} descricao={descricao}>
  <article class="aparelho">
    {/* Cabeçalho de impressão (ticket 78): só existe no papel, para a folha
        levar marca, modelo, Versão da tabela e origem INMETRO. */}
    <div class="ficha-impressao">
      <p class="ficha-impressao-site">Especialista do Ar · Ficha técnica</p>
      <p class="ficha-impressao-titulo">{aparelho.marca} — {aparelho.modelo}</p>
      <p class="ficha-impressao-meta">
        Origem: INMETRO
        {versao
          ? ` · Versão da tabela: ${versao.hash.slice(0, 12)} · obtida em ${versao.obtidoEm}`
          : null}
      </p>
    </div>

    <Trilha itens={trilha} />

    <div class="ficha-cabecalho">
      <div class="ficha-identidade">
        <h1>{aparelho.marca} — {aparelho.modelo}</h1>
        <ul class="ficha-etiquetas">
          <li class="ficha-etiqueta">
            <span class="ficha-etiqueta-rotulo">Classe</span>{" "}
            <EtiquetaClasse classes={etiquetas.classes} />
            {
              etiquetas.classes.length === 0 ? (
                <span class="ficha-etiqueta-valor">—</span>
              ) : null
            }
          </li>
          {
            etiquetas.registros.length > 0 ? (
              <li class="ficha-etiqueta">
                <span class="ficha-etiqueta-rotulo">Situação</span>{" "}
                <span class="ficha-etiqueta-valor">{etiquetas.situacao}</span>
              </li>
            ) : null
          }
          {
            etiquetas.registros.length > 0 ? (
              <li class="ficha-etiqueta ficha-etiqueta-registro">
                <span class="ficha-etiqueta-rotulo">
                  {etiquetas.registros.length === 1 ? "Registro" : "Registros"}
                </span>{" "}
                <span class="ficha-etiqueta-valor">
                  {etiquetas.registros.join(", ")}
                </span>
              </li>
            ) : null
          }
        </ul>
      </div>

      <div class="ficha-acoes">
        <a
          class="botao botao-secundario"
          href={`/comparar/?ids=${encodeURIComponent(aparelho.id)}`}
        >
          Comparar este modelo
        </a>
        <button class="botao botao-texto" type="button" data-imprimir-ficha>
          Imprimir ficha
          <Icone nome="impressora" tamanho={16} />
        </button>
      </div>
    </div>

    <ul class="ficha-leituras">
      {
        leituras.map((leitura) => (
          <li data-leitura={leitura.chave}>
            <Leitura
              rotulo={leitura.rotulo}
              valor={leitura.valor}
              unidade={leitura.unidade}
              legenda={leitura.legenda}
              href={leitura.href}
            />
          </li>
        ))
      }
    </ul>

    <nav
      class="ficha-indice"
      aria-label="Seções desta ficha"
      data-indice-ficha
    >
      <p class="ficha-indice-rotulo">Nesta ficha</p>
      <ul>
        {
          indice.map((secao, posicao) => (
            <li>
              <a
                href={`#${secao.id}`}
                data-secao={secao.id}
                aria-current={posicao === 0 ? "location" : undefined}
              >
                {secao.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section id="resumo" tabindex="-1">
      <h2>Resumo</h2>
      <dl class="ficha-resumo">
        {
          resumoLinhas.map(([rotulo, valor]) => (
            <div>
              <dt>{rotulo}</dt>
              <dd>{valor}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="entenda-os-numeros" tabindex="-1">
      <h2>Entenda os números</h2>
      <div class="explicadores">
        {
          EXPLICADORES_DA_FICHA.map((explicador) => (
            <details class="explicador">
              <summary>{explicador.titulo}</summary>
              {explicador.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
            </details>
          ))
        }
      </div>
    </section>

    <section id="consumo-e-custo" tabindex="-1" class="secao-consumo-custo">
      <h2>Consumo e custo</h2>
      <p class="intro">
        Quanto este Aparelho pesa na conta de luz no seu uso. O consumo anual do
        INMETRO é medido em {HORAS_ANO} horas por ano (cerca de 5,7 h/dia);
        aqui ele é convertido para horas, dias e a tarifa da sua conta.
      </p>

      <CalculadoraCusto
        client:load
        consumosAnuaisKwh={resumo.consumosKwh}
        tarifas={tarifas}
      />

      <div class="como-calculamos">
        <h3>Como calculamos</h3>
        <p>
          O INMETRO mede o consumo no ciclo de {HORAS_ANO} horas por ano — o
          equivalente a cerca de 5,7 h/dia. A conta parte desse número:
        </p>
        <ol>
          <li>consumo por hora = consumo anual ÷ {HORAS_ANO};</li>
          <li>consumo mensal = consumo por hora × horas por dia × dias por mês;</li>
          <li>custo mensal = consumo mensal × tarifa (R$/kWh);</li>
          <li>custo anual = custo mensal × 12.</li>
        </ol>
        <p>
          O custo anual considera 12 meses iguais, sem sazonalidade nem bandeiras
          tarifárias. Assim, o seu uso pode custar diferente: o resultado é uma
          estimativa, calculada no seu navegador, com as entradas que você
          informa.
        </p>
        <p>
          Exemplo com valores redondos: um Aparelho de 416 kWh/ano consome 0,2
          kWh por hora (416 ÷ {HORAS_ANO}); em 8 h/dia por 30 dias, são 48 kWh no
          mês; com tarifa de R$ 0,85/kWh, o custo é de R$ 40,80 por mês e R$ 489,60
          por ano.
        </p>
      </div>
    </section>

    <section id="condicoes-de-ensaio" tabindex="-1">
      <h2>Condições de ensaio</h2>
      <p class="intro">
        As condições de ensaio combinam a temperatura externa (35 °C e 29 °C) com a
        carga (total e parcial). Cada célula mostra a capacidade e a potência
        elétrica declaradas pelo INMETRO, em W.
      </p>
      {
        blocos.map((bloco, indiceBloco) => {
          const grade = gradeDeCondicoes(bloco.dados);
          return (
            <section class="variante">
              <h3>{titulos[indiceBloco]}</h3>
              {grade.linhas.length === 0 ? (
                <p class="intro">Sem dados nas condições de ensaio.</p>
              ) : (
                <div
                  class="ficha-tabela"
                  role="group"
                  tabindex="0"
                  aria-label={`Condições de ensaio — ${titulos[indiceBloco]}`}
                >
                  <table>
                    <caption>
                      Capacidade / potência elétrica, em W
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Condição</th>
                        {grade.mostrarTotal ? (
                          <th scope="col">Carga total</th>
                        ) : null}
                        {grade.mostrarParcial ? (
                          <th scope="col">Carga parcial</th>
                        ) : null}
                      </tr>
                    </thead>
                    <tbody>
                      {grade.linhas.map((linha) => (
                        <tr>
                          <th scope="row">{linha.temperatura} °C</th>
                          {grade.mostrarTotal ? (
                            <td>{formatarCelula(linha.total)}</td>
                          ) : null}
                          {grade.mostrarParcial ? (
                            <td>{formatarCelula(linha.parcial)}</td>
                          ) : null}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              <p class="ficha-nota">
                Linhas da tabela: {bloco.linhas.join(", ")}.
              </p>
            </section>
          );
        })
      }
    </section>

    {
      identificacao.length > 0 ? (
        <section id="especificacoes" tabindex="-1">
          <h2>Especificações</h2>
          <dl class="ficha-especificacoes">
            {identificacao.map(([rotulo, valor]) => (
              <div>
                <dt>{rotulo}</dt>
                <dd>{valor}</dd>
              </div>
            ))}
          </dl>
        </section>
      ) : null
    }

    {
      aparelho.registros.length > 0 ? (
        <section id="registros" tabindex="-1">
          <h2>Registros INMETRO</h2>
          <ul class="ficha-registros">
            {aparelho.registros.map((registro) => (
              <li>
                <span class="ficha-registro-numero">{registro.numero}</span>
                <span class="ficha-status" data-situacao={registro.status}>
                  {registro.status}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <section id="proveniencia" tabindex="-1">
      <h2>Proveniência</h2>
      <p class="ficha-nota">Linhas da tabela: {aparelho.linhas.join(", ")}.</p>
      <p>
        Os valores acima são Valores oficiais, padronizados apenas quanto ao
        formato.
      </p>
    </section>

    {
      analise ? (
        <section id="analise" tabindex="-1" class="analise-destaque">
          <h2>Leia a análise</h2>
          <p>{analise.descricao}</p>
          <p>
            <a class="ficha-analise-link" href={analise.url}>
              {analise.titulo}
            </a>
          </p>
        </section>
      ) : null
    }

    <OfertaFaixa ofertas={ofertas} id="ofertas" />

    <p class="ficha-outros">
      <a href={`/aparelhos/?marca=${encodeURIComponent(marcaCatalogo)}`}>
        Ver outros aparelhos da marca {marcaCatalogo}
      </a>
    </p>
  </article>

  {/* Duas ações de página sem ilha: imprimir a ficha e marcar no índice a
      seção em leitura. O HTML já traz a primeira seção marcada; o script só
      corrige a marcação conforme a rolagem e não é pré-requisito para nenhum
      link. */}
  <script is:inline>
  (() => {
    const botao = document.querySelector("[data-imprimir-ficha]");
    if (botao) {
      botao.addEventListener("click", () => window.print());
    }

    const indice = document.querySelector("[data-indice-ficha]");
    if (!indice) {
      return;
    }
    const links = Array.from(indice.querySelectorAll("a[data-secao]"));
    const secoes = links
      .map((link) => document.getElementById(link.dataset.secao))
      .filter((secao) => secao !== null);
    if (secoes.length === 0) {
      return;
    }

    let atual = "";
    const marcar = (id) => {
      if (id === atual) {
        return;
      }
      atual = id;
      for (const link of links) {
        if (link.dataset.secao === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    const medir = () => {
      // Abaixo do desktop o índice não é sticky: o limite vira o topo da tela.
      const limite = Math.max(indice.getBoundingClientRect().bottom, 0) + 8;
      let id = secoes[0].id;
      for (const secao of secoes) {
        if (secao.getBoundingClientRect().top <= limite) {
          id = secao.id;
        }
      }
      marcar(id);
    };

    let agendado = false;
    const agendar = () => {
      if (agendado) {
        return;
      }
      agendado = true;
      requestAnimationFrame(() => {
        agendado = false;
        medir();
      });
    };

    window.addEventListener("scroll", agendar, { passive: true });
    window.addEventListener("resize", agendar);
    window.addEventListener("hashchange", agendar);
    medir();
  })();
  </script>
</Base>
