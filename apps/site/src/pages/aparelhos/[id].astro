---
import aparelhosJson from "@dados/aparelhos.json";
import type {
  Aparelho,
  DadosDeclarados,
  Tensao,
} from "@especialista-do-ar/pipeline";
import OfertaFaixa from "../../components/OfertaFaixa.astro";
import { carregarAnalises } from "../../conteudo/analises.ts";
import { marcaCatalogoDo } from "../../conteudo/marcas-catalogo.ts";
import { ofertasDoAparelho } from "../../conteudo/ofertas.ts";
import Base from "../../layouts/Base.astro";
import { type Analise, mapaPorAparelho } from "../../lib/analises.ts";
import type { Oferta } from "../../lib/ofertas.ts";

export async function getStaticPaths() {
  const aparelhos = aparelhosJson as Aparelho[];
  // O link de volta depende do mapa `aparelhoId → Análise` construído no build.
  const { analises } = await carregarAnalises();
  const analisePorAparelho = mapaPorAparelho(analises);
  return aparelhos.map((aparelho) => ({
    params: { id: aparelho.id },
    props: {
      aparelho,
      // As Ofertas vêm do glue do site, que valida o insumo (inclusive Oferta
      // órfã) no primeiro uso do build — ver `conteudo/ofertas.ts` e ADR-0010.
      ofertas: ofertasDoAparelho(aparelho.id),
      analise: analisePorAparelho.get(aparelho.id),
    },
  }));
}

interface Props {
  aparelho: Aparelho;
  ofertas: Oferta[];
  analise: Analise | undefined;
}

const { aparelho, ofertas, analise } = Astro.props;

// A Marca de catálogo (ADR-0016) é o agrupamento curado usado pelo filtro e pelo
// link "Ver outros aparelhos da marca". A ficha continua exibindo a Marca
// oficial do INMETRO no título, no `<h1>` e na URL.
const marcaCatalogo = marcaCatalogoDo(aparelho);

function texto(valor: number | null, sufixo = ""): string {
  return valor === null ? "—" : `${valor.toLocaleString("pt-BR")}${sufixo}`;
}

function tensaoTexto(tensao: Tensao | null): string {
  if (tensao === null || tensao.voltagens.length === 0) {
    return "—";
  }
  const voltagens = `${tensao.voltagens.join(" / ")} V`;
  return tensao.fases.length === 0
    ? voltagens
    : `${voltagens} · ${tensao.fases.join(", ")}`;
}

function linhasDados(dados: DadosDeclarados): Array<[string, string]> {
  return [
    ["Capacidade nominal", texto(dados.capacidadeNominalBtu, " BTU/h")],
    ["Capacidade nominal", texto(dados.capacidadeNominalW, " W")],
    ["Potência esperada", texto(dados.potenciaEsperaW, " W")],
    ["IDRS", texto(dados.idrs)],
    ["Consumo anual", texto(dados.consumoAnualKwh, " kWh/ano")],
    ["Capacidade — 35 °C total", texto(dados.capacidade35TotalW, " W")],
    ["Potência — 35 °C total", texto(dados.potencia35TotalW, " W")],
    ["Capacidade — 35 °C parcial", texto(dados.capacidade35ParcialW, " W")],
    ["Potência — 35 °C parcial", texto(dados.potencia35ParcialW, " W")],
    ["Capacidade — 29 °C total", texto(dados.capacidade29TotalW, " W")],
    ["Potência — 29 °C total", texto(dados.potencia29TotalW, " W")],
    ["Capacidade — 29 °C parcial", texto(dados.capacidade29ParcialW, " W")],
    ["Potência — 29 °C parcial", texto(dados.potencia29ParcialW, " W")],
  ];
}

const identificacao: Array<[string, string | null]> = [
  ["Tipo", aparelho.tipo],
  ["Função", aparelho.funcao],
  ["Rotação", aparelho.rotacao],
  ["Unidade interna", aparelho.unidadeInterna],
  ["Unidade externa", aparelho.unidadeExterna],
  ["Fluido refrigerante", aparelho.fluidoRefrigerante],
  ["Fluido especificado", aparelho.fluidoEspecificado],
];

const descricao = `${aparelho.marca} ${aparelho.modelo}: capacidade, consumo, IDRS e tensão conforme os Dados declarados do INMETRO.`;
---

<Base titulo={`${aparelho.marca} ${aparelho.modelo} — Especialista do Ar`} descricao={descricao}>
  <article class="aparelho">
    <p><a href="/">← Voltar ao catálogo</a></p>
    <h1>{aparelho.marca} — {aparelho.modelo}</h1>

    <dl>
      {
        identificacao
          .filter(([, valor]) => valor !== null && valor !== "")
          .map(([rotulo, valor]) => (
            <>
              <dt>{rotulo}</dt>
              <dd>{valor}</dd>
            </>
          ))
      }
    </dl>

    <h2>Registros INMETRO</h2>
    <ul>
      {
        aparelho.registros.map((registro) => (
          <li>
            {registro.numero} · {registro.status}
          </li>
        ))
      }
    </ul>

    <h2>Dados declarados por Variante</h2>
    {
      aparelho.variantes.map((variante) => (
        <section class="variante">
          <h3>Tensão: {tensaoTexto(variante.tensao)}</h3>
          <table>
            <tbody>
              {linhasDados(variante.dados).map(([rotulo, valor]) => (
                <tr>
                  <th scope="row">{rotulo}</th>
                  <td>{valor}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="intro">
            Linhas da tabela: {variante.linhas.join(", ")}.
          </p>
        </section>
      ))
    }

    <h2>Proveniência</h2>
    <p class="intro">
      Linhas da tabela: {aparelho.linhas.join(", ")}. Os valores acima são
      Valores oficiais, padronizados apenas quanto ao formato.
    </p>

    {
      analise ? (
        <section class="analise-destaque">
          <h2>Leia a análise</h2>
          <p class="intro">{analise.descricao}</p>
          <p>
            <a href={analise.url}>{analise.titulo}</a>
          </p>
        </section>
      ) : null
    }

    <OfertaFaixa ofertas={ofertas} />

    <p>
      <a href={`/?marca=${encodeURIComponent(marcaCatalogo)}`}>
        Ver outros aparelhos da marca {marcaCatalogo}
      </a>
    </p>
  </article>
</Base>
