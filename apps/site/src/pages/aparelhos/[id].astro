---
import aparelhosJson from "@dados/aparelhos.json";
import type { Aparelho } from "@especialista-do-ar/pipeline";
import CalculadoraCusto from "../../components/CalculadoraCusto.tsx";
import OfertaFaixa from "../../components/OfertaFaixa.astro";
import { carregarAnalises } from "../../conteudo/analises.ts";
import { marcaCatalogoDo } from "../../conteudo/marcas-catalogo.ts";
import { ofertasDoAparelho } from "../../conteudo/ofertas.ts";
import { carregarTarifas } from "../../conteudo/tarifas.ts";
import Base from "../../layouts/Base.astro";
import { type Analise, mapaPorAparelho } from "../../lib/analises.ts";
import { HORAS_ANO } from "../../lib/custo.ts";
import {
  agruparVariantes,
  cartoesDeDestaque,
  descreverCapacidade,
  etiquetasDaFicha,
  formatarCelula,
  formatarFaixa,
  gradeDeCondicoes,
  indiceDaFicha,
  resumoDaFicha,
  titulosDosBlocos,
} from "../../lib/ficha.ts";
import type { Oferta } from "../../lib/ofertas.ts";

export async function getStaticPaths() {
  const aparelhos = aparelhosJson as Aparelho[];
  // O link de volta depende do mapa `aparelhoId → Análise` construído no build.
  const { analises } = await carregarAnalises();
  const analisePorAparelho = mapaPorAparelho(analises);
  return aparelhos.map((aparelho) => ({
    params: { id: aparelho.id },
    props: {
      aparelho,
      // As Ofertas vêm do glue do site, que valida o insumo (inclusive Oferta
      // órfã) no primeiro uso do build — ver `conteudo/ofertas.ts` e ADR-0010.
      ofertas: ofertasDoAparelho(aparelho.id),
      analise: analisePorAparelho.get(aparelho.id),
    },
  }));
}

interface Props {
  aparelho: Aparelho;
  ofertas: Oferta[];
  analise: Analise | undefined;
}

const { aparelho, ofertas, analise } = Astro.props;

// A Marca de catálogo (ADR-0016) é o agrupamento curado usado pelo filtro e pelo
// link "Ver outros aparelhos da marca". A ficha continua exibindo a Marca
// oficial do INMETRO no título, no `<h1>` e na URL.
const marcaCatalogo = marcaCatalogoDo(aparelho);

// Variantes de dados idênticos (127 V e 220 V) viram um bloco só; as vazias
// desaparecem. O resumo é do Aparelho inteiro, com faixa quando as Variantes
// divergem — a ficha continua mostrando cada condição de ensaio logo abaixo.
const blocos = agruparVariantes(aparelho.variantes);
const resumo = resumoDaFicha(blocos);
const titulos = titulosDosBlocos(blocos);

// O topo da ficha (ticket 62): as etiquetas de identificação e os três cartões
// de destaque saem do mesmo resumo que as seções, com faixa quando as Variantes
// divergem. O índice só lista seções que existem nesta página.
const etiquetas = etiquetasDaFicha(resumo, aparelho.registros);
const cartoes = cartoesDeDestaque(resumo);

// As tarifas de referência são curadoria do site (ADR-0022), validadas no build
// e cacheadas por caminho: a mesma leitura serve as 2.460 fichas.
const tarifas = carregarTarifas();

const identificacao: Array<[string, string | null]> = [
  ["Tipo", aparelho.tipo],
  ["Função", aparelho.funcao],
  ["Unidade interna", aparelho.unidadeInterna],
  ["Unidade externa", aparelho.unidadeExterna],
  ["Fluido refrigerante", aparelho.fluidoRefrigerante],
  ["Fluido especificado", aparelho.fluidoEspecificado],
].filter(([, valor]) => valor !== null && valor !== "");

const secoesPresentes = new Set([
  "resumo",
  "consumo-e-custo",
  "condicoes-de-ensaio",
  ...(identificacao.length > 0 ? ["especificacoes"] : []),
  ...(aparelho.registros.length > 0 ? ["registros"] : []),
  "proveniencia",
  ...(ofertas.length > 0 ? ["ofertas"] : []),
]);
const indice = indiceDaFicha(secoesPresentes);

const descricao = `${aparelho.marca} ${aparelho.modelo}: capacidade, consumo, IDRS e tensão conforme os Dados declarados do INMETRO.`;
---

<Base titulo={`${aparelho.marca} ${aparelho.modelo} — Especialista do Ar`} descricao={descricao}>
  <article class="aparelho">
    <p><a href="/aparelhos/">← Voltar aos aparelhos</a></p>
    <h1>{aparelho.marca} — {aparelho.modelo}</h1>

    <div class="ficha-topo">
      <ul class="ficha-etiquetas">
        <li
          class="ficha-etiqueta ficha-etiqueta-classe"
          data-classe={etiquetas.classes.length === 1
            ? etiquetas.classes[0]
            : undefined}
        >
          Classe {etiquetas.classe}
        </li>
        {
          etiquetas.registros.length > 0 ? (
            <li class="ficha-etiqueta">Situação: {etiquetas.situacao}</li>
          ) : null
        }
        {
          etiquetas.registros.length > 0 ? (
            <li class="ficha-etiqueta ficha-etiqueta-registro">
              {etiquetas.registros.length === 1 ? "Registro" : "Registros"}{" "}
              {etiquetas.registros.join(", ")}
            </li>
          ) : null
        }
      </ul>
      <p class="ficha-acoes">
        <a
          class="ficha-comparar"
          href={`/comparar/?ids=${encodeURIComponent(aparelho.id)}`}
        >
          Comparar este modelo
        </a>
      </p>
    </div>

    <ul class="ficha-destaques">
      {
        cartoes.map((cartao) => (
          <li class="ficha-destaque" data-destaque={cartao.chave}>
            {cartao.ancora === null ? (
              <>
                <p class="ficha-destaque-rotulo">{cartao.rotulo}</p>
                <p class="ficha-destaque-valor">{cartao.valor}</p>
                <p class="ficha-destaque-legenda">{cartao.legenda}</p>
              </>
            ) : (
              <a class="ficha-destaque-link" href={cartao.ancora}>
                <p class="ficha-destaque-rotulo">{cartao.rotulo}</p>
                <p class="ficha-destaque-valor">{cartao.valor}</p>
                <p class="ficha-destaque-legenda">{cartao.legenda}</p>
                <span class="ficha-destaque-acao">Ver consumo e custo</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <nav class="ficha-indice" aria-label="Seções desta ficha">
      <p class="ficha-indice-rotulo">Nesta ficha</p>
      <ul>
        {
          indice.map((secao) => (
            <li>
              <a href={`#${secao.id}`}>{secao.rotulo}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section id="resumo" tabindex="-1">
      <h2>Resumo</h2>
      <dl>
        <dt>Capacidade nominal</dt>
        <dd>{descreverCapacidade(resumo)}</dd>
        <dt>IDRS</dt>
        <dd>{formatarFaixa(resumo.idrs)}</dd>
        <dt>Classe</dt>
        <dd>{resumo.classes.join(", ") || "—"}</dd>
        <dt>Consumo anual</dt>
        <dd>{formatarFaixa(resumo.consumosKwh, " kWh/ano")}</dd>
        <dt>Potência em espera</dt>
        <dd>{formatarFaixa(resumo.potenciasEsperaW, " W")}</dd>
      </dl>
    </section>

    <section id="consumo-e-custo" tabindex="-1" class="secao-consumo-custo">
      <h2>Consumo e custo</h2>
      <p class="intro">
        Quanto este Aparelho pesa na conta de luz no seu uso. O consumo anual do
        INMETRO é medido em {HORAS_ANO} horas por ano (cerca de 5,7 h/dia);
        aqui ele é convertido para horas, dias e a tarifa da sua conta.
      </p>

      <CalculadoraCusto
        client:load
        consumosAnuaisKwh={resumo.consumosKwh}
        tarifas={tarifas}
      />

      <div class="como-calculamos">
        <h3>Como calculamos</h3>
        <p>
          O INMETRO mede o consumo no ciclo de {HORAS_ANO} horas por ano — o
          equivalente a cerca de 5,7 h/dia. A conta parte desse número:
        </p>
        <ol>
          <li>consumo por hora = consumo anual ÷ {HORAS_ANO};</li>
          <li>consumo mensal = consumo por hora × horas por dia × dias por mês;</li>
          <li>custo mensal = consumo mensal × tarifa (R$/kWh);</li>
          <li>custo anual = custo mensal × 12.</li>
        </ol>
        <p>
          O custo anual considera 12 meses iguais, sem sazonalidade nem bandeiras
          tarifárias. Assim, o seu uso pode custar diferente: o resultado é uma
          estimativa, calculada no seu navegador, com as entradas que você
          informa.
        </p>
        <p>
          Exemplo com valores redondos: um Aparelho de 416 kWh/ano consome 0,2
          kWh por hora (416 ÷ {HORAS_ANO}); em 8 h/dia por 30 dias, são 48 kWh no
          mês; com tarifa de R$ 0,85/kWh, o custo é de R$ 40,80 por mês e R$ 489,60
          por ano.
        </p>
      </div>
    </section>

    <section id="condicoes-de-ensaio" tabindex="-1">
      <h2>Condições de ensaio</h2>
      <p class="intro">
        As condições de ensaio combinam a temperatura externa (35 °C e 29 °C) com a
        carga (total e parcial). Cada célula mostra a capacidade e a potência
        elétrica declaradas pelo INMETRO, em W.
      </p>
      {
        blocos.map((bloco, indiceBloco) => {
          const grade = gradeDeCondicoes(bloco.dados);
          return (
            <section class="variante">
              <h3>{titulos[indiceBloco]}</h3>
              {grade.linhas.length === 0 ? (
                <p class="intro">Sem dados nas condições de ensaio.</p>
              ) : (
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Condição</th>
                      {grade.mostrarTotal ? <th scope="col">Carga total</th> : null}
                      {grade.mostrarParcial ? (
                        <th scope="col">Carga parcial</th>
                      ) : null}
                    </tr>
                  </thead>
                  <tbody>
                    {grade.linhas.map((linha) => (
                      <tr>
                        <th scope="row">{linha.temperatura} °C</th>
                        {grade.mostrarTotal ? (
                          <td>{formatarCelula(linha.total)}</td>
                        ) : null}
                        {grade.mostrarParcial ? (
                          <td>{formatarCelula(linha.parcial)}</td>
                        ) : null}
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              <p class="intro">
                Linhas da tabela: {bloco.linhas.join(", ")}.
              </p>
            </section>
          );
        })
      }
    </section>

    {
      identificacao.length > 0 ? (
        <section id="especificacoes" tabindex="-1">
          <h2>Especificações</h2>
          <dl>
            {identificacao.map(([rotulo, valor]) => (
              <>
                <dt>{rotulo}</dt>
                <dd>{valor}</dd>
              </>
            ))}
          </dl>
        </section>
      ) : null
    }

    {
      aparelho.registros.length > 0 ? (
        <section id="registros" tabindex="-1">
          <h2>Registros INMETRO</h2>
          <ul>
            {aparelho.registros.map((registro) => (
              <li>
                {registro.numero} · {registro.status}
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <section id="proveniencia" tabindex="-1">
      <h2>Proveniência</h2>
      <p class="intro">
        Linhas da tabela: {aparelho.linhas.join(", ")}. Os valores acima são
        Valores oficiais, padronizados apenas quanto ao formato.
      </p>
    </section>

    {
      analise ? (
        <section class="analise-destaque">
          <h2>Leia a análise</h2>
          <p class="intro">{analise.descricao}</p>
          <p>
            <a href={analise.url}>{analise.titulo}</a>
          </p>
        </section>
      ) : null
    }

    <OfertaFaixa ofertas={ofertas} id="ofertas" />

    <p>
      <a href={`/aparelhos/?marca=${encodeURIComponent(marcaCatalogo)}`}>
        Ver outros aparelhos da marca {marcaCatalogo}
      </a>
    </p>
  </article>
</Base>
