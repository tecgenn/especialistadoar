---
import aparelhosJson from "@dados/aparelhos.json";
import consultaJson from "@dados/consulta.json";
import type { ItemConsulta } from "@especialista-do-ar/api/consulta";
import type { Aparelho } from "@especialista-do-ar/pipeline";
import Consulta from "../../components/Consulta.tsx";
import { carregarAnalises, mapaAnalisados } from "../../conteudo/analises.ts";
import { carregarFiltros } from "../../conteudo/filtros.ts";
import Base from "../../layouts/Base.astro";
import { opcoesDe } from "../../lib/opcoes.ts";

const dataset = consultaJson as ItemConsulta[];
// Os chips (marcas e capacidades conhecidas) vêm da curadoria do site; o resto
// continua no `<select>`. A curadoria é validada aqui, no build.
const opcoes = opcoesDe(dataset, carregarFiltros());

// Mapa de Aparelhos analisados para a tabela (ticket 28).
const { analises } = await carregarAnalises();
const idsDaBase = new Set((aparelhosJson as Aparelho[]).map((a) => a.id));
const analisados = mapaAnalisados(analises, idsDaBase);

const descricao =
  "Tabela de aparelhos de ar-condicionado com os Dados declarados do INMETRO: compare marca, modelo, capacidade, consumo, IDRS e Classe, com filtros e ordenação.";

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Aparelhos de ar-condicionado",
  description: descricao,
  url: Astro.site ? new URL("/aparelhos/", Astro.site).href : undefined,
  inLanguage: "pt-BR",
  isPartOf: {
    "@type": "WebSite",
    name: "Especialista do Ar",
    url: Astro.site?.href,
  },
};
---

<Base
  titulo="Aparelhos de ar-condicionado — Especialista do Ar"
  descricao={descricao}
  jsonLd={jsonLd}
>
  <h1>Aparelhos de ar-condicionado</h1>
  <p class="intro">
    {dataset.length} Aparelhos com Dados declarados, a partir da exportação
    oficial de produtos do INMETRO. Ordene por qualquer coluna e filtre por
    marca, capacidade, função, tipo, Classe e tensão.
  </p>
  <Consulta client:load opcoes={opcoes} analisados={analisados} />
</Base>
