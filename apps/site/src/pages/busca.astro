---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import Base from "../layouts/Base.astro";
---

<Base
  titulo="Buscar no site — Especialista do Ar"
  descricao="Busca de texto completo nas páginas do catálogo de aparelhos de ar-condicionado."
>
  <h1>Buscar no site</h1>
  <p class="intro">
    Busca de texto completo nas páginas de cada Aparelho (índice Pagefind). Para
    filtrar por marca, tipo, capacidade e tensão, use a
    <a href="/aparelhos/">lista de aparelhos</a>.
  </p>
  <PagefindConfig />
  <pagefind-searchbox></pagefind-searchbox>
</Base>
