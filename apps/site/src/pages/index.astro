---
import consultaJson from "@dados/consulta.json";
import type { ItemConsulta } from "@especialista-do-ar/api/consulta";
import AnalisesDestaque from "../components/AnalisesDestaque.astro";
import HomeDestaquesPorCapacidade from "../components/HomeDestaquesPorCapacidade.astro";
import Botao from "../components/primitivos/Botao.astro";
import CabecalhoDeSecao from "../components/primitivos/CabecalhoDeSecao.astro";
import SimuladorHero from "../components/SimuladorHero.tsx";
import { carregarAnalises } from "../conteudo/analises.ts";
import { carregarFiltros } from "../conteudo/filtros.ts";
import { ofertasPublicadas } from "../conteudo/ofertas.ts";
import Base from "../layouts/Base.astro";
import {
  type DestaqueAnalise,
  mapaPorAparelho,
  ofertasDoDestaque,
} from "../lib/analises.ts";
import { CAPACIDADES_COMERCIAIS } from "../lib/assistente.ts";
import {
  capacidadesComDestaque,
  contagensPorCapacidade,
  contarBase,
  EXPLICACAO_DO_RECORTE,
  formatarNumero,
  jsonLdPerguntasFrequentes,
  PERGUNTAS_FREQUENTES,
} from "../lib/home.ts";
import { indexarOfertas } from "../lib/ofertas.ts";

// A home é um hub (ticket 46) montado inteiro no build: as contagens e os
// cartões das capacidades em destaque (ticket 96) saem do dataset de consulta
// publicado, as capacidades da curadoria do site e o FAQ da mesma lista que
// alimenta o JSON-LD. Nada de JSON baixado no cliente.
const dataset = consultaJson as ItemConsulta[];
const curadoria = carregarFiltros();
const contagens = contarBase(dataset);
const porCapacidade = contagensPorCapacidade(dataset);
// O simulador do hero arredonda para uma capacidade comercial: o recorte
// (`?btu=`) e o resumo de eficiência dessa capacidade saem da mesma base que
// a tabela serve, no build.
const resumosComerciais = Object.fromEntries(
  CAPACIDADES_COMERCIAIS.map((btu) => {
    const itens = dataset.filter((item) => item.capacidadesBtu.includes(btu));
    return [
      String(btu),
      {
        total: itens.length,
        classeA: itens.filter((item) => item.classes.includes("A")).length,
      },
    ];
  }),
);
// Os destaques são montados no build: cada Análise publicada, na ordem da mais
// recente para a mais antiga, com as Ofertas do Aparelho já resolvidas. Um
// Aparelho Ausente não tem Oferta (o glue recusa Oferta órfã), então fica sem
// CTA sem precisar de checagem própria. Quando a Análise compara dois
// Aparelhos, as Ofertas dos dois entram no mesmo destaque (ticket 97).
const { analises } = await carregarAnalises();
const ofertasPorAparelho = indexarOfertas(ofertasPublicadas());
const destaques: DestaqueAnalise[] = analises.map((analise) => ({
  analise,
  ofertas: ofertasDoDestaque(analise, ofertasPorAparelho),
}));
// Os blocos por capacidade exata (ticket 96) substituem as listas de populares.
// Análises e Ofertas chegam indexadas pelo mesmo `aparelhoId` da tabela; uma
// capacidade só vira bloco quando há pelo menos um Aparelho com uma das duas.
const indiceDestaques = {
  dataset,
  analisesPorAparelho: mapaPorAparelho(analises),
  ofertasPorAparelho,
};
const blocosDestaque = capacidadesComDestaque(indiceDestaques, curadoria).map(
  (bloco) => ({
    ...bloco,
    totalNaCapacidade: porCapacidade.get(bloco.capacidadeBtu) ?? 0,
  }),
);

const descricao = `Ar-condicionado e BTUs com os dados oficiais do INMETRO: compare capacidade, consumo, IDRS e Classe de ${formatarNumero(contagens.aparelhos)} aparelhos e descubra quantos BTUs o seu ambiente precisa.`;

// `WebSite` continua; o `FAQPage` é somado ao mesmo `<head>` (ticket 46).
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Especialista do Ar",
    url: Astro.site?.href,
    inLanguage: "pt-BR",
    description: descricao,
  },
  jsonLdPerguntasFrequentes(),
];
---

<Base
  titulo="Ar-condicionado e BTUs: compare aparelhos com dados do INMETRO — Especialista do Ar"
  descricao={descricao}
  jsonLd={jsonLd}
>
  <section class="home-hero" aria-labelledby="home-titulo">
    {/* O título é grande de propósito: esta é a única tela do site em que a
        escala display abre acima do token, com duas linhas fixas para que a
        entrada possa subir cada uma do próprio mask. O #103 trocou o título
        que vendia a base por um que vende a decisão: “Ar-condicionado” sai do
        H1 visual e continua no `title`, na description e no texto da página. */}
    <h1 id="home-titulo" class="home-titulo">
      <span class="home-titulo-linha">
        <span class="home-titulo-texto">Seu conforto começa</span>
      </span>
      {/* Abaixo do desktop as linhas são inline: o espaço explícito impede
          "começapela" quando o Astro remove o espaço entre as tags. */}{" "}
      <span class="home-titulo-linha">
        <span class="home-titulo-texto">pela escolha certa</span>
      </span>
    </h1>
    <p class="home-hero-lead intro">
      Descubra quantos BTUs seu ambiente precisa e compare modelos de
      ar-condicionado por capacidade, consumo e eficiência energética, com base
      em dados oficiais do INMETRO.
    </p>
    {/* A primeira pergunta do visitante é quantos BTUs ele precisa: o CTA
        ancora no simulador em vez de pular direto para `/assistente/`, que é
        o passo seguinte oferecido no resultado. */}
    <div class="home-hero-acao">
      <Botao href="#simulador" icone="seta-direita">
        Encontrar meu ar ideal
      </Botao>
    </div>
    <SimuladorHero client:load resumos={resumosComerciais} />
  </section>

  <section class="home-confianca" aria-label="Cobertura da base">
    <p class="home-confianca-rotulo">Cobertura da base</p>
    <p class="home-confianca-numeros">
      <span class="home-confianca-item">
        <strong>{formatarNumero(contagens.aparelhos)}</strong> aparelhos
      </span>
      <span class="home-confianca-item">
        <strong>{formatarNumero(contagens.marcas)}</strong> marcas
      </span>
      <span class="home-confianca-item">
        <strong>{formatarNumero(contagens.capacidades)}</strong> capacidades
      </span>
    </p>
    <p class="home-confianca-origem">
      Tudo a partir da exportação oficial de produtos do INMETRO.
    </p>
  </section>

  {blocosDestaque.map((bloco) => <HomeDestaquesPorCapacidade {...bloco} />)}

  <AnalisesDestaque destaques={destaques} />

  <section class="home-faq" aria-labelledby="home-faq-titulo">
    <CabecalhoDeSecao icone="perguntas" id="home-faq-titulo" titulo="Perguntas frequentes" />
    <div class="home-faq-lista">
      {
        PERGUNTAS_FREQUENTES.map(({ pergunta, resposta }) => (
          <details class="home-pergunta">
            <summary>
              <h3>{pergunta}</h3>
            </summary>
            <p>{resposta}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="home-metodologia" aria-labelledby="home-metodologia-titulo">
    <CabecalhoDeSecao
      icone="camadas"
      id="home-metodologia-titulo"
      titulo="Metodologia e INMETRO"
    />
    {/* Ticket 99: cada tópico é um `<details>` nativo, fechado por padrão,
        como o FAQ acima. Fecha o texto longo que antes ficava todo exposto sem
        cortar conteúdo: o mesmo texto editorial segue na página. */}
    <div class="home-metodologia-lista">
      <details class="home-tema">
        <summary>
          <h3>De onde vêm os dados</h3>
        </summary>
        <p>
          Os dados técnicos — capacidade, consumo, IDRS e Classe — vêm da
          exportação oficial de produtos do INMETRO e são reproduzidos como
          Valores oficiais, sem correção editorial.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>O recorte da tabela</h3>
        </summary>
        <p>{EXPLICACAO_DO_RECORTE}</p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>IDRS e Classe energética</h3>
        </summary>
        <p>
          O <strong>IDRS</strong> (Índice de Desempenho de Refrigeração Sazonal)
          é a razão entre o calor removido e a energia elétrica consumida, em
          Wh/Wh: quanto maior, mais eficiente. A <strong>Classe</strong> é a
          faixa de eficiência (A a F) declarada na coluna “Faixa de
          Classificação” do INMETRO. Nenhuma das duas é recalculada pelo site.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>Condições de ensaio</h3>
        </summary>
        <p>
          O INMETRO mede o consumo e a capacidade em três condições de ensaio:
          <strong>carga total a 35 °C</strong>,
          <strong>carga parcial a 35 °C</strong> e
          <strong>carga parcial a 29 °C</strong>. Os números publicados na ficha
          vêm dessas medições, feitas sempre com a mesma referência.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>Vigência da classificação</h3>
        </summary>
        <p>
          A classificação A–F vigente entrou em vigor em
          <strong>1º de janeiro de 2023</strong>, pela
          <strong>Portaria INMETRO 269/2021</strong>. Por isso, não compare uma
          etiqueta atual com uma Classe declarada antes dessa data.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>Aparelhos Inverter</h3>
        </summary>
        <p>
          A tecnologia <strong>Inverter</strong> ajusta a velocidade do
          compressor em vez de ligar e desligar o tempo todo. É por isso que
          dois modelos de mesma capacidade podem consumir quantidades
          diferentes de energia: o IDRS e o consumo anual declarados no INMETRO
          são a forma de compará-los.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>Simulador e Assistente</h3>
        </summary>
        <p>
          O simulador do hero usa área e incidência de sol. No
          <a href="/assistente/">Assistente completo</a>, você ajusta pessoas,
          eletrônicos, lâmpadas e janelas, abre a conta fator por fator e vê o
          nível de confiança da estimativa.
        </p>
      </details>
      <details class="home-tema">
        <summary>
          <h3>O que é estimativa</h3>
        </summary>
        <p>
          A recomendação do Assistente é uma <strong>estimativa</strong>
          calculada por heurística de mercado: não é um Valor oficial nem um
          cálculo de carga térmica. Para ambientes complexos ou acima de 60.000
          BTU/h, procure uma avaliação técnica.
        </p>
      </details>
    </div>
    <p class="home-fontes">
      Fontes · exportação oficial de produtos do INMETRO · Portaria INMETRO
      269/2021 · ciclo de referência de 2.080 h/ano
    </p>
  </section>

  <script>
    import { redirecionarFiltrosAntigos } from "../lib/redirect.ts";

    // A tabela saiu da home no ticket 29. Um link antigo com filtros
    // (`/?marca=…`) é levado a `/aparelhos/` com a mesma querystring.
    redirecionarFiltrosAntigos(window.location, (url) => {
      window.location.replace(url);
    });
  </script>
</Base>
