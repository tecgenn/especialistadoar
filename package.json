{
  "name": "especialista-do-ar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node packages/pipeline/src/cli.ts build --data-dir data",
    "build:site": "pnpm --filter @especialista-do-ar/site run build",
    "dev:site": "pnpm --filter @especialista-do-ar/site run dev",
    "preview:site": "pnpm --filter @especialista-do-ar/site run preview",
    "verificar-links": "node apps/site/scripts/verificar-links.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  }
}
